# Data files — synthetic CSVs (large; regenerate with generate_pos.py)
# Keep .gitkeep placeholders; ignore actual data files
data/raw/clean/*.csv
data/raw/dirty/*.csv
data/raw/dirty/*.json
data/quarantine/*.csv
data/quarantine/*.json
# Keep timestamped quarantine copies out of git too
data/quarantine/*_dirty*

# Reports (generated at runtime)
reports/quality.json

# pytest cache
.pytest_cache/
