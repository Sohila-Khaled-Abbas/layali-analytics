# Layali Analytics Database Connection Configuration
# NOTE: Copy this file to .env and adjust values if needed.
# Credentials and sensitive settings must never be committed to source control.

DB_SERVER=localhost
DB_NAME=LayaliAnalytics
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_TRUSTED_CONNECTION=yes
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=yes
DB_PORT=1433
